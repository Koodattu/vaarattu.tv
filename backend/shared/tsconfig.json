{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node"],
    "module": "node20",
    "lib": ["ES2020"],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "prisma/schema.prisma"],
  "exclude": ["node_modules", "dist"]
}
