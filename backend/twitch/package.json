{
  "name": "@vaarattu/backend-twitch",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "db:generate": "cd ../shared && npm run db:generate",
    "db:push": "cd ../shared && npm run db:push",
    "db:migrate": "cd ../shared && npm run db:migrate",
    "test": "node --require ts-node/register --test --test-concurrency=1 tests/*.test.cjs",
    "test:openai": "node --require ts-node/register --test tests/openai.service.test.cjs",
    "recordings": "ts-node src/recordings.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mkody/twitch-emoticons": "^2.9.9",
    "@vaarattu/shared": "file:../shared",
    "@twurple/api": "^8.2.0",
    "@twurple/auth": "^8.2.0",
    "@twurple/chat": "^8.2.0",
    "@twurple/eventsub-base": "^8.2.0",
    "@twurple/eventsub-ws": "^8.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "openai": "^7.60.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
