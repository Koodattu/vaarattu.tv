{
  "name": "@vaarattu/backend-twitch",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "db:generate": "cd ../shared && npm run db:generate",
    "db:push": "cd ../shared && npm run db:push",
    "db:migrate": "cd ../shared && npm run db:migrate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:openai": "node --require ts-node/register --test tests/openai.service.test.cjs",
    "recordings": "ts-node src/recordings.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@mkody/twitch-emoticons": "^2.9.9",
    "@vaarattu/shared": "file:../shared",
    "@twurple/api": "^8.1.4",
    "@twurple/auth": "^8.1.4",
    "@twurple/chat": "^8.1.4",
    "@twurple/eventsub-base": "^8.1.4",
    "@twurple/eventsub-ws": "^8.1.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
