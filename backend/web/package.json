{
  "name": "@vaarattu/backend-web",
  "version": "1.0.0",
  "description": "Web API backend for vaarattu.tv",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --require ts-node/register src/index.ts",
