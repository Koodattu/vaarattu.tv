    "express": "^5.3.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
